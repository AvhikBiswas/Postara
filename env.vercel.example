# Import this file in Vercel → Project Settings → Environment Variables.
# Fill every empty value first. Do not upload this file until secrets are real.
#
# Supabase: Project Settings → Database → Connect
#   DATABASE_URL = Transaction pooler URI (port 6543) + ?pgbouncer=true
#   DIRECT_URL   = Session pooler or direct URI (port 5432)
#
# Generate AUTH_SECRET / ENCRYPTION_KEY / APPROVAL_SIGNING_KEY / CRON_SECRET:
#   pnpm env:vercel

APP_URL=https://YOUR_PROJECT.vercel.app
NODE_ENV=production
AUTH_SECRET=
NEXTAUTH_URL=https://YOUR_PROJECT.vercel.app
DATABASE_URL=
DIRECT_URL=
ENCRYPTION_KEY=
APPROVAL_SIGNING_KEY=
CRON_SECRET=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
DEFAULT_LLM_MODEL=openai/gpt-4o-mini
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/api/linkedin/callback
RESEND_API_KEY=
EMAIL_FROM=Postara <noreply@YOUR_DOMAIN>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_MODE=false
REDIS_URL=
