# One env file. Copy to .env locally, or generate .env.vercel for Vercel import:
#   APP_URL=https://your-app.vercel.app pnpm env:vercel
# Never commit filled values.

# ========== REQUIRED for production ==========

# Public URL, no trailing slash
APP_URL=http://localhost:3000
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000

# openssl rand -base64 32
AUTH_SECRET=

# Supabase → Project Settings → Database → Connect
# DATABASE_URL = Transaction pooler (port 6543). Add ?pgbouncer=true if missing.
# DIRECT_URL   = Session pooler or Direct (port 5432) — used only for migrations.
DATABASE_URL=
DIRECT_URL=

# openssl rand -hex 32   (both keys, separately)
ENCRYPTION_KEY=
APPROVAL_SIGNING_KEY=

# Vercel Cron auth. openssl rand -hex 32
CRON_SECRET=

# OpenRouter — free/cheap models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default: free router. Alternatives: google/gemma-4-31b-it:free  |  google/gemini-2.5-flash-lite
DEFAULT_LLM_MODEL=openrouter/free

# First admin, created only when the database is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ========== Recommended (LinkedIn Autopilot actually publishes) ==========

# LinkedIn Developer app — Sign In + Share. Redirect: ${APP_URL}/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Resend — approval emails. https://resend.com
RESEND_API_KEY=
EMAIL_FROM=

# ========== Optional ==========

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
DEMO_MODE=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
