# Copy to .env for local development, or import env.vercel.example in Vercel.
# Never commit real values. Generate secrets with: pnpm env:vercel

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Supabase Postgres (Project Settings → Database → Connection string) ---
# Transaction pooler (port 6543) for the app / Vercel
DATABASE_URL=
# Session pooler or direct (port 5432) for Prisma migrate
DIRECT_URL=

# openssl rand -hex 32
ENCRYPTION_KEY=
APPROVAL_SIGNING_KEY=

# --- Queue (optional on Vercel — jobs run inline when unset) ---
REDIS_URL=

# --- AI ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# --- LinkedIn OAuth (never store LinkedIn passwords) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Vercel cron ---
CRON_SECRET=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- First admin (created only when the database is empty) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local-only seed. Leave unset / false in production.
DEMO_MODE=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Docker Compose local Postgres only
POSTGRES_PASSWORD=
